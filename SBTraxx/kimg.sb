# dx WNARR ?
let bssslah_comp = comp()
{
  setup()
  {
    let bz = [27, 30, 34, 37];
    let bx = 0;
    let durz = [100, 200, 300, 90, 100, 500] ;
    let drx = 0;
    let velz = [90, 100, 100, 110, 120, 127, 127, 127];
    let vx = 0;
    let lennz = [2, 2, 3, 1, 4, 6];
    let lnx = 0;
  }
  run()
  {
    for (let i = 0; i < 16; i++) {
      if (i % lennz[lnx] == 1) {
        note_on_at(dx, bz[bx], i * pp, dur = durz[drx], vel = velz[vx]);
        drx = incr(drx, 0, len(durz));
        vx = incr(vx, 0, len(velz));
      }
    }
    if (count % 2 == 1) {
      bx = incr(bx, 0, len(bz));
      lnx = incr(lnx, 0, len(lennz));
    }
  }
}

let hhblah_comp = comp()
{
  setup()
  {
    let hhzl = [12, 32, 16, 6, 8];
    let hx = 0;
    let velz = [80, 60, 70, 80, 90];
    l110et vx = 0;
  }
  run()
  {
    let pp = 3840 / hhzl[hx];
    for (let i = 0; i < hhzl[hx]; i++) {
      note_on_at(hh, 1, i * pp, vel = velz[vx]);
      vx = incr(vx, 0, len(velz));
    }
    hx = incr(hx, 0, len(hhzl));

  }
}
