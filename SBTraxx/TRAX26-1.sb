let dxblah_comp = comp()
{
  setup()
  {
    let basepat = [1, 0, 0, 1,  1, 0, 0, 0,  1, 0, 0, 1,  0];
    let px = 0;
    let chrd =  notes_in_chord(31,31,1,1);
    let durz = [50, 100, 150, 125, 20, 40];
    let drx = 0;
    let velz = [120, 127, 127, 100, 90, 80, 100, 120, 100];
    let vx = 0;
  }
  run()
  {
    let pat = basepat;
    if (count % 8 == 7) {
      pat = rand_array(16, 0, 1);
    }
    for (let i = 0; i < 16; i++) {
      if (pat[px] == 1) {
        note_on_at(dx, chrd, i * pp, dur = durz[drx], vel = velz[vx]);
      } else {
        note_on_at(dx3, chrd, i * pp, dur = durz[drx], vel = velz[vx]);
      }
      px = incr(px, 0, len(pat));
      vx = incr(vx, 0, len(velz));
    }
    drx = incr(drx, 0, len(durz));
  }
}

let fxblah_comp = comp()
{
  setup()
  {
    let mainramp = phasor(3840 / 4);
  }
  run()
  {
    set mixer:grev 0;
    set mixer:gdlfb 0;
    set mixer:gdly 0;
    if (count % 8 == 7) {
      for (let i = 0; i < 3840; i++) {
        let sig = signal_from(mainramp);
        let sendv = scale(sig, 0, 1, 0, 0.2);
        set mixer:grev sendv at=i;
        set mixer:gdly sendv at=i;
        #let fbfll = scale(sig, 0, 1, 0, 10);
        #set mixer:gdlfb fbfll at=i;
      }
    }
  }
}

