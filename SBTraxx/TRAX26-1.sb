let mooooblah_comp = comp()
{
  setup()
  {
    let chrd1 = notes_in_chord(31,31,1,1);
    let chrd2 = notes_in_chord(36,31,1,1);
    let chrd3 = notes_in_chord(38,31,1,1);
    let pat =  [3, 3, 1, 3,  4, 0, 3, 1,  2, 2, 4, 2,  2, 3, 2, 1];
    let chrdz = [chrd1, chrd2, chrd3];
  }
  run()
  {
    if (count % 3 == 0) {
      pat = rand_array(16, 0, 4);
    }
    for (let i = 0; i < 16; i++) {
      if (pat[i] < len(chrdz)) {
        note_on_at(mo, up(chrdz[pat[i]], 12), i * pp, dur = 300);
      }
    }
  }
}

