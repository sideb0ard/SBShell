let hhatzblah_comp = comp()
{
  setup()
  {
    let hatz = [0, 0, 1, 0,  0, 0, 1, 0,  1, 0, 1, 1,  1, 0, 0, 0];
    let swng = 110;
    let velz = [60, 80, 100, 120, 90, 90, 100, 60, 77];
    let vlx = 0;
  }
  run()
  {
    for (let i = 0; i < 16; i++) {
      let offset = swng;
      if (i % 2 == 0) {
        offset = 0;
      }
      if (i % 4 == 2) {
        note_on_at(sbdrum, 3, i * pp + offset, vel = velz[vlx]);
        vlx = incr(vlx, 0, len(velz));
      }
    }
  }
}


let dlblah_comp = comp()
{
  setup()
  {
    let pat = [1, 1, 1, 0,  0, 0, 1, 1,  0, 0, 1, 0,  0, 1, 0, 1];
  }
  run()
  {
    let patr = pat;
    if (count % 4 == 3) {
      patr = rand_array(16, 0, 1);
    }
    for (let i = 0; i < 16; i++) {
      if (pat[i] == 1) {
        #note_on_at(droop, i, i * pp, dur = pp*2);
      } else {
        if (count % 2 == 1) {
          note_on_at(band, i, i * pp, dur = pp*4);
        }
      }
    }
  }
}
