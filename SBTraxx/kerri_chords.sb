let droop = NULL;
let band = NULL;
let init = fn()
{
  load_preset(dx, "PBR_S-Gang");
  # load_drum_part(sbdrum, "TUMPR", "bd");
  # load_drum_part(sbdrum, "TUMPR", "cp");
  load_preset(sbdrum, "KEERIC");
  droop = loop(dloops2/droopzfixd.aif);
  set droop:pitch 2;
  note_off(droop, 0);
  band = loop(dloops2/banduLU.wav);
  set band:pitch 2;
  note_off(band, 0);


}
let kerriblah_comp = comp()
{
  setup()
  {
  }
  run()
  {
    if (count % 8 < 4) {
      kerri_dsharp_prog();
    } else {
      kerri_dsharp_ext();
    }
  }
}
