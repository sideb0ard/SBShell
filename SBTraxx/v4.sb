          #     }
        #   }
      # }
  }
}

let nested_tuplet_roll = comp()
{
  setup()
  {
    let bar = pp * 16;
    let third = bar / 3;
  }
  run()
  {
    for (let i = 0; i < 5; i++) {
      note_on_at(sb2, 1, i * third / 5, vel = 50);
    }

    for (let i = 0; i < 7; i++) {
      note_on_at(sb2, 1, third + (i * third / 7), vel = 70);
    }

    for (let i = 0; i < 3; i++) {
      note_on_at(sb2, 1, (third * 2) + (i * third / 3), vel = 90);
    }
  }
}

let bounce_roll = comp()
{
  setup()
  {
    let decay = 0.75;
    let num_hits = 12;
  }
  run()
  {
    let pos = 0;
    let gap = pp * 4;

    for (let i = 0; i < num_hits; i++) {
      let v = 60 + (i * 5);
      if (v > 127) { v = 127; }

      note_on_at(sb2, 1, pos, vel = v);

      pos = pos + gap;
      gap = gap * decay;
    }
  }
}

let percblah_comp = comp()
{
  setup()
  {
    let percz = [perc1, perc2, perc3, perc4];
    let pitchz = [1, 2, 1.7, 0.8, 0.6, 1.5, 1.1];
    let px = 0;
    let pat = rand_array(16, 0, 6);
  }
  run()
  {

    if (count % 4 == 3) {
      pat = rand_array(16, 0, 6);
    }

    for (let i = 0; i < 16; i++) {
      if (pat[i] < len(percz)) {
        note_on_at(percz[pat[i]], 1, i * pp, dur = 22);
        set percz[pat[i]]:pitch pitchz[px] at=i * pp;
        px = incr(px, 0, len(pitchz));
      }
    }
  }
}

let peshblah_comp = comp()
{
  setup()
  {
    let beat1 = [1, 0, 0, 1,  0, 0, 1, 0,  0, 0, 1, 0,  0, 0, 1, 0];
    let pix = 0;
    let pmax = 3;
    let pitz = [1, 2, 1.5, 0.6, 0.7, 1.2];
    let px = 0;
  }
  run()
  {
    let beat = beat1;
    if (count % 2 == 1) {
      beat = rand_array(16, 0, 1);
    }

    if (count % 8 < 6) {
      for (let i = 0; i < 16; i++) {
        if (beat[i] == 1) {
          note_on_at(pesh, pix, i * pp);
          set mixer:xfader:xpos -1 at=i*pp;
        } else {
          note_on_at(rock, pix, i * pp);
          set mixer:xfader:xpos 1 at=i*pp;
        }
        pix = incr(pix, 0, pmax);
      }
    } else {
      if (count % 8 == 7) {
        nested_tuplet_roll();
      }
    }

    if (count % 4 == 3) {
      pmax = incr(pmax, 3, 16);
      set pesh:reverse 1;
      set rock:reverse 1;
    }
    if (count % 6 == 2) {
      # print("pitch:", pitz[px]);
      #solo(pesh, at=12*pp);
      set pesh:pitch pitz[px];
      px = incr(px, 0, len(pitz));
      set rock:pitch pitz[px];
    }
    if (count % 8 == 0) {
      set rock:gate 1;
      set pesh:stutter 1;
    }
    if (count % 8 == 3) {
      set rock:octave_jump 1;
      set pesh:strobe 1;
    }
    if (count % 8 == 4) {
      set rock:strobe 1;
      set pesh:octave_jump 1;
    }
    if (count % 8 == 5) {
      set pesh:pitch_ramp 1;
      set rock:pitch_ramp 1;
    }
    if (count % 8 == 6) {
      set rock:slowdown 1;
      set pesh:pitch_ramp 1;
    }
    if (count % 8 == 7) {
      set pesh:gate 1;
      set rock:reverse 1;
    }
  }
}

