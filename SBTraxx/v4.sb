let BASSblah_comp = comp()
{
  setup()
  {
    let bassline= {261:"27:127:172", 989:"27:127:234", 1558:"27:127:179", 2036:"25:127:322", 2743:"25:127:244", 3379:"25:127:225", 3928:"32:127:322", 4663:"32:127:249", 5274:"32:127:240", 5823:"33:127:966"};

    let rhym1 = [0, 27, 0, 0,  27, 0, 27, 0,  25, 0, 0, 25,  0, 0, 25, 0];
    let rhym2 = [32, 0, 0, 32,  0, 0, 32, 0,  33, 0, 0, 0,  0, 0, 0, 0];
  }
  run()
  {
    let rhym = rhym1;
    if (count % 2 == 1) {
      rhym = rhym2;
    }
    for (let i = 0; i < 16; i++) {
      let dr = 240;
      let swng = 70;
      if (i % 2 == 0) {
        swng = 0;
      }
      if (rhym[i] == 33) {
        dr = 240 * 3;
      }
      if (rhym[i] > 0) {
        note_on_at(dx2, rhym[i], i * pp + swng, dur = dr);
      }
    }

  }
}
