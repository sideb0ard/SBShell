
let perc1 = NULL;
let perc2 = NULL;
let perc3 = NULL;
let perc4 = NULL;
let pesh = NULL;
let rock = NULL;
let wash = NULL;

let key = NULL;

let init = fn()
{
#   load_preset(sbdrum, "V4");
  key = 52;

  bpm 130;

  pesh = loop(dloops/peshayBrwak.aiff);
  add_fx(pesh, "distort");
  set pesh:fx0:mode 1;
  set pesh:fx0:threshold 0.2;
  set pesh:plooplen 2;
  set pesh:poffset 6;
  rock = loop(legowelt/Synth-SimpleBeautyLow.wav);
  vol rock 0;
  vol pesh 0;

  send("delay", sd);
  set sd:pitch 1.8;
  # load_preset(dx, "spacepiano");
  # load_preset(dx3, "jazz_organ");
  load_preset(dx, "kotokoto__");
  load_preset(dx3, "ORGAN");
  perc1 = sample(perc/kk.wav);
  perc2 = sample(glitchedVinyl/pitchsweel.wav);
  perc3 = sample(noises/RevPercMatmos.aiff);
  perc4 = sample(noises/Woodblock2_bip.aif);

  #wash = loop(loops/washreverbloop.aiff);
  #add_fx(wash, "sidechain", sbdrum);
  # p3 < osc 8 "-40 0" "set wash:fx0:threshold %";
  # add_fx(wash, "reverb");
  # p4 < osc 13 "10 90" "set wash:fx1:wetmx %";
  # p1 # peshblah_comp;
  p4 # dx1blah_comp;
  #p10 # wahblah_comp;
  p99 # PLAYYblah_comp;
  load_drum_part(sbdrum, "CRISP", "sd");
  #add_fx(wash, "sidechain", sbdrum, "bd");
  load_drum_part(sb2, "RVB", "sd");
  load_drum_part(sb2, "FMHH", "fm1");
  load_drum_part(sb2, "OOH", "oh");
  set sb2:hh_vol 0.6;
  set sb2:oh_attack 50;

  load_preset(mo, "V4z");

  add_fx(mo, "sidechain", sbdrum, "bd");

  vol hh 0.4;
  vol oh 0.4;
  vol ch 0.5;
  pan hh 0.2;
  pan oh 0.4;
  pan ch -0.3;
}

