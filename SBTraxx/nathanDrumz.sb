# dx - club_organ
# g#
let key = 44;
# minor
let key_mod = 1;
# 9th
let chord_mod = 5;
let notez = notes_in_key(44, 1);

let dxblah_comp = comp()
{
  setup()
  {
    let chordprog = [0, 3, 3, 4];
    let chx = 0;
  }
  run()
  {
    let chrd = notes_in_chord(notez[chordprog[chx]], key, chord_mod, key_mod);
    chx = incr(chx, 0, len(chordprog));
    note_on(dx, chrd, dur = 3000);
  }
}
