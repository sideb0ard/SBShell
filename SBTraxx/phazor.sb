#[47, 51, 54, 58]
let init = fn()
{
  phzz = [];
  for (let i = 0; i < len(pentz); i++) {
    push(phzz, phasor(basephs * pentz[i]));
  }
  load_preset(sbdrum, "CRAKZ2");
  # load_preset(dx, "SMOOUTH2");
  stop = sample(noises/soulIIsoulSTOP.wav);
  set stop:pitch 4;
  send(delay, stop);
  add_fx(stop, "distort");

  add_fx(dx, "djeq");
  walkin = loop(noises/walkinRain.aiff);
  add_fx(walkin, "distort");
  add_fx(walkin, "djeq");

  sbs = sbsynth();
  # add_buf(sbs, "notes/slaveChord3.aiff");
  # add_buf(sbs, "notes/garageyChord.aiff");
  # add_buf(sbs, "notes/noteWitMAWWelp.aiff");

  load_preset(dx3, "WAFFLE");
}


let resetPhaz = fn()
{
  basephs = 3840 / 4;
  for (let i = 0; i < len(pentz); i++) {
    if (rand(100) > 50) {
      change_steps(phzz[i], basephs * rand(harmz));
    } else {
      change_steps(phzz[i], basephs * rand(pentz));
    }
  }
}
let resetOrigPhaz = fn()
{
  basephs = 3840 / 4;
  for (let i = 0; i < len(pentz); i++) {
    change_steps(phzz[i], basephs * pentz[i]);
  }
}

let check_wrap = fn(last_val, cur_val)
{
  if (cur_val < last_val) {
    return true;
  }
  return false;
}

# p2 < osc 11 "1 10" "set sbdrum:cp_fq %";
let phblah_comp = comp()
{
  setup()
  {
    let cptz = [180, 80, 200, 1680];
    let cx = 0;
    let freqz = [11, 2];
    let frx = 0;
  }
  run()
  {
    unsolo();
    if (count % 8 == 0) {
      resetOrigPhaz();
      set sbdrum:fm1_mod_freq_rat freqz[frx];
      frx = incr(frx, 0, len(freqz));
    }
    if (count % 8 == 6) {
      resetPhaz();
    }
    if (count % 4 == 3) {
      set sbdrum:cp_tone cptz[cx];
      cx = incr(cx, 0, len(cptz));
    }

    if (count % 16 < 15) {
      for (let i = 0; i < pplooplen; i++) {
        for (let j = 0; j < len(phzz); j++) {
          let phval = signal_from(phzz[j]);
          #print("LASTV:", lastvalz[j], " pHAL:", phval);
          if (check_wrap(lastvalz[j], phval)) {
            #print("J:", j, " DRMAX:", drmax);
            if (j < drmax) {
              note_on_at(sbdrum, drumz[j], i);
            }
          }
          lastvalz[j] = phval;
        }
      }
    } else {
      solo(stop);
      note_on(stop, 1, dur = 0);
    }
    drmax = incr(drmax, 2, len(drumz));
  }
}

let key = 54;

# brokecomputa
# SMOOUTH2
let dx2blah_comp = comp()
{
  setup()
  {
    let dif = 0.7;
    let num_hitz=   [3, 7, 8, 6, 9];
    let nx = 0;
    let notez = notes_in_key(key);
    let chrdz = [4, 4, 1, 0];
    let chx = 0;
    let durz = [700, 250, 400, 60, 100, 300];
    let drx = 0;
  }
  run()
  {
    if (count % 2 == 0) {
      let num_hit = num_hitz[nx];
      nx = incr(nx, 0, len(num_hitz));
      let chrd = notes_in_chord(notez[chrdz[chx]], key, 1);
      let pos = 0;
      let gap = pp * 4;
      for (let i = 0; i < num_hit; i++) {
        note_on_at(dx,  chrd, pos, dur = durz[drx]);
        drx = incr(drx, 0, len(durz));
        pos = pos + gap;
        gap = gap * dif;
      }
      chx = incr(chx, 0, len(chrdz));
    }
  }
}

let ramp2slope_factory = fn()
{
  let history_val = 0;
  fn(newval) {
    let oldval = history_val;
    history_val = newval;
    let delta = newval - oldval;
    if (delta < -0.5) {
      return 1 + delta;
    }
    if (delta > 0.5) {
      return 1 - delta;
    }
    return delta;
  }
}

let ramp_div_factory = fn()
{
  let normalize_ramp = ramp2slope_factory();
  let accum = 0;

  return fn(sig_val, ratio) {
    let val = normalize_ramp(sig_val) / ratio;
    #print("SIG:", sig_val, " NORMAL:", val);
    accum = accum + val;
    if (accum >= 1) {
      accum = accum - 1;
    }
    if (accum < 0) {
      accum = accum + 1;
    }
    return accum;
  }

  # let sig_mult = sig_val * steps;
  # sig_mult = sig_mult % modr;
  # return sig_mult / modr;
}

let ramp2trigger_factory = fn()
{
  let history_val = 0;
  fn(newval) {
    let oldval = history_val;
    history_val = newval;
    let delta = abs(newval - oldval);
    if (delta > 0.5) {
      return true;
    }
    return false;
  }
}

