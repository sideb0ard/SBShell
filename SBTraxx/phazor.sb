#[47, 51, 54, 58]
# let walkin = loop(noises/walkinRain.aiff);
# add_fx(walkin, "distort");
# add_fx(walkin, "djeq");
let newphasor = comp()
{
  setup()
  {
    let fullramp = phasor(3840);
    let steps = 8;
    let modr = 3;
    let divz = [16, 12, 8, 4, 6, 3];
    let dvx = 0;
    let sincr = TWO_PI / 3840;
    let sinidx = 0;

    let ramp_div1 = ramp_div_factory();
    let ramp_div2 = ramp_div_factory();
    let ramp_div3 = ramp_div_factory();

    let ramp2tri = ramp2trigger_factory();

  }
  run()
  {
    let plot_width = 120;
    let stride = 3840 / plot_width;
    for (let i = 0; i < 3840; i++) {
      let ramp_sig = signal_from(fullramp);
      #let out_sig2 = ramp_div(ramp_sig, 1/2);
      #let out_sig = ramp_sig * 0.5;
      #print("RAMPSIG:", ramp_sig, " OUTSIG:", out_sig);
      let out_sig1 = ramp_div1(ramp_sig, 1 / 6);
      let out_sig2 = ramp_div2(ramp_sig, 3 / 8);
      let mod_ratio = max(out_sig2, 0.001);
      let out_sig3 = ramp_div3(out_sig1, mod_ratio);
      let sin_sig = sin(sinidx) / 2 + 0.5;
      sinidx = (sinidx + sincr) % TWO_PI;
      let sig_mult = ramp_sig * 8;
      sig_mult = sig_mult % 3;
      let out_sig = sig_mult / 3;
      #print("OUTSIG:", out_sig1, " OUT2:", out_sig2, " OUT3:", out_sig3);
      #let out_sig = (sig * divz[dvx]) % 1;
      if (i % stride == 0) {
        if (ramp2tri(out_sig3)) {
          #print("TRIG:", i);
          #note_on_at(dx, 203, i, dur = 180);
        }
        #draw_plot(sin_sig * out_sig3, plot_width, at = i);
        #draw_plot(out_sig3, plot_width, at = i);
        set dx:fx0:lo scale(out_sig3, 0, 1, 80, 3000) at=i;
        set dx:op2out scale(out_sig3, 0, 1, 40, 90) at=i;

        set walkin:fx1:lo scale(out_sig3, 0, 1, 80, 3000) at=i;
      }
      #print("OUTSIG:", out_sig);
    }
    dvx = incr(dvx, 0, len(divz));
  }
}

let FXblah_comp = comp()
{
  setup()
  {
    let chrd1 = notes_in_chord(47, 47, 1);
    let chrd2 = notes_in_chord(52, 47, 1);
  }
  run()
  {
    if (count % 8 == 0) {
      note_off(dx, 0);
      note_on_at(dx, chrd2, 300, dur = 0);
      note_on_at(dx, chrd2, 300, dur = 0);
    }
    if (count % 8 == 6) {
      note_off(dx, 0);
      note_on_at(dx, chrd1, 300, dur = 0);
      note_on_at(dx, chrd1, 300, dur = 0);
    }
  }
}

let drumblah_comp = comp()
{
  setup()
  {
    let steps = 8;
    let modr = 3;
    let divz = [16, 12, 8, 4, 6, 3];
    let dvx = 0;
    let sincr = TWO_PI / 3840 ;
    let sinidx = 0;

    let ramplenz = [1, 2, 3, 4, 6, 8, 12, 16, 24, 30, 32];
    let rx = 0;

    let ramp_div1 = ramp_div_factory();
    let ramp_div2 = ramp_div_factory();
    let ramp_div3 = ramp_div_factory();

    let ramp2tri = ramp2trigger_factory();

    let notez = [23, 27, 30, 34, 11, 15, 18, 22];
    #let notez = [20];
    let nx = 0;

    let durz = [30, 50, 60, 100, 200, 300];
    let drx = 0;
  }
  run()
  {
    let plot_width = 120;
    let stride = 3840 / plot_width;
    let fullramp = phasor(3840 / ramplenz[rx]);
    rx = incr(rx, 0, len(ramplenz));
    for (let i = 0; i < 3840; i++) {
      let ramp_sig = signal_from(fullramp);
      let out_sig1 = ramp_div1(ramp_sig, 2 / 3);
      let out_sig2 = ramp_div2(ramp_sig, 3 / 4);
      let mod_ratio = max(out_sig2, 0.001);
      let out_sig3 = ramp_div3(out_sig1, mod_ratio);
      set sbs:morph out_sig3;
      set sbs:pd out_sig2;

      let pan_val = scale(out_sig3, 0, 1, -1, 1);
      pan sbs pan_val at=i;

      if (i % stride == 0) {
        if (ramp2tri(out_sig3)) {
          if (i % 2 == 0) {
            note_on_at(sbs, notez[nx], i, dur = durz[drx]);
            nx = incr(nx, 0, len(notez));
          }
          if (i % 3 == 0) {
            note_on_at(sbs, notez[nx], i, dur = durz[drx]);
          }
        }
        #draw_plot(sin_sig * out_sig3, plot_width, at = i);
        #draw_plot(out_sig3, plot_width, at = i);
      }
      #print("OUTSIG:", out_sig);
    }
    drx = incr(drx, 0, len(durz));
  }
}

# dx3 flopiano // soft_harp_ // basss // SMOOUTH // WAFFLE
let simplerampblah_comp = comp()
{
  setup()
  {
    let ramp_div1 = ramp_div_factory();
    let ramp_div2 = ramp_div_factory();
    let ramp_div3 = ramp_div_factory();
    let ramp2tri = ramp2trigger_factory();

    let plot_width = 120;
    let stride = 3840 / plot_width;
    #let fullramp = phasor(3840 * 2);
    let fullramp = phasor(3840);

    let chrd1 = notes_in_chord(47, 47, 1);
    let chrd2 = notes_in_chord(52, 47, 1);

    let durz = [100, 200, 300, 450, 600];
    let drx = 0;
  }
  run()
  {
    let chrd = chrd1;
    if (count % 8 == 7) {
      chrd = chrd2;
    }
    if (count % 13 == 0) {
      chrd = up(chrd, 24);
    }
    for (let i = 0; i < 3840; i++) {
      let rampval = signal_from(fullramp);
      let out_sig1 = ramp_div1(rampval, 3 / 8);
      let out_sig2 = ramp_div2(rampval, 7 / 4);
      let mod_ratio = max(out_sig2, 0.001);
      let out_sig3 = ramp_div3(out_sig1, mod_ratio);
      set dx3:op2out scale(out_sig2, 0, 1, 0, 99) at = i;
      if (ramp2tri(out_sig3)) {
        #print("NOTEON:", i);
        note_on_at(dx3, chrd, i, dur = durz[drx]);
        drx = incr(drx, 0, len(durz));
      }
    }
  }
}

let xblah_comp = comp()
{
  setup()
  {
    xassign(0, dx);
    xassign(1, dx3);
    let ramp_div1 = ramp_div_factory();
    let ramp_div2 = ramp_div_factory();
    let ramp_div3 = ramp_div_factory();
    let ramp2tri = ramp2trigger_factory();

    let plot_width = 120;
    let stride = 3840 / plot_width;
    #let fullramp = phasor(3840 * 2);
    let fullramp = phasor(3840);

  }
  run()
  {
    for (let i = 0; i < 3840; i++) {
      let rampval = signal_from(fullramp);
      let out_sig1 = ramp_div1(rampval, 3 / 8);
      let out_sig2 = ramp_div2(rampval, 2 / 4);
      let mod_ratio = max(out_sig2, 0.001);
      let out_sig3 = ramp_div3(out_sig1, mod_ratio);
      let xmix = scale(out_sig3, 0, 1, -1, 1);
      set mixer:xfader:xpos xmix at = i;
      # if (i % stride == 0) {
        #   draw_plot(out_sig3, plot_width, at = i);
        # }
    }
  }
}

# let bomb = loop(glitchedVinyl/bombbomwaom.wav); set bomb:len 2;
let osloblah_comp = comp()
{
  setup()
  {
    let ramp_div1 = ramp_div_factory();
    let ramp_div2 = ramp_div_factory();
    let ramp_div3 = ramp_div_factory();
    let ramp2tri = ramp2trigger_factory();

    let plot_width = 120;
    let stride = 3840 / plot_width;
    #let fullramp = phasor(3840 * 2);
    let fullramp = phasor(3840);
    let sincr = TWO_PI / 3840;
    let sinidx = 0;
  }
  run()
  {
    for (let i = 0; i < 3840; i++) {
      let rampval = signal_from(fullramp);
      let out_sig1 = ramp_div1(rampval, 2 / 1);
      let out_sig2 = ramp_div2(rampval, 3 / 7);
      let mod_ratio = max(out_sig2, 0.001);
      let out_sig3 = ramp_div3(out_sig1, mod_ratio);
      set bomb:fx0:fb scale(out_sig2, 0, 1, 0, 99) at = i;
      pan bomb scale(out_sig3, 0, 1, -1, 1) at = i;

      if (ramp2tri(out_sig3)) {
        #print("NOTEON:", i);
        note_on_at(bomb, floor(16 * out_sig1), i, dur = 0);

        # note_on_at(dx3, chrd, i, dur = durz[drx]);
        # drx = incr(drx, 0, len(durz));
      }
    }
  }
}

