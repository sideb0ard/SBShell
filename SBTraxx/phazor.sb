    let stride = 3840 / plot_width;
    #let fullramp = phasor(3840 * 2);
    let fullramp = phasor(3840);
    let sincr = TWO_PI / 3840;
    let sinidx = 0;
  }
  run()
  {
    for (let i = 0; i < 3840; i++) {
      let rampval = signal_from(fullramp);
      let out_sig1 = ramp_div1(rampval, 2 / 7);
      let out_sig2 = ramp_div2(rampval, 3 / 4);
      let mod_ratio = max(out_sig2, 0.001);
      let out_sig3 = ramp_div3(out_sig1, mod_ratio);

      #if (i % stride == 0) {
        #  draw_plot(out_sig1, plot_width, at = i);
